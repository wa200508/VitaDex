{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VitaDex Card Database",
  "type": "object",
  "required": [
    "background_templates",
    "organisms",
    "art_assets"
  ],
  "properties": {
    "background_templates": {
      "type": "array",
      "description": "Available card background templates.",
      "items": {
        "type": "object",
        "required": ["id", "name", "style", "preview"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "style": { "type": "string" },
          "preview": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "description": { "type": "string" }
        }
      }
    },
    "organisms": {
      "type": "array",
      "description": "Organism entries for dynamic card generation.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type",
          "description",
          "habitat",
          "environment_role",
          "rarity"
        ],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "move_set": { "type": "array", "items": { "type": "string" } },
          "description": { "type": "string" },
          "habitat": { "type": "string" },
          "habitat_type": { "type": "string" },
          "environment_role": { "type": "string" },
          "physical_dimensions": { "type": "string" },
          "rarity": { "type": "string" },
          "related_forms": { "type": "array", "items": { "type": "string" } },
          "lifecycle_stage": { "type": "string" },
          "group": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "art_assets": {
      "type": "array",
      "description": "Art prompts and image references associated with organisms.",
      "items": {
        "type": "object",
        "required": ["organism_name", "prompt", "assets"],
        "properties": {
          "organism_name": { "type": "string" },
          "prompt": { "type": "string" },
          "assets": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}

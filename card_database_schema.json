{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VitaDex Card Database",
  "type": "object",
  "required": [
    "background_templates",
    "organisms",
    "art_assets"
  ],
  "properties": {
    "background_templates": {
      "type": "array",
      "description": "Available card background templates.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "style",
          "preview"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "style": {
            "type": "string"
          },
          "preview": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "organisms": {
      "type": "array",
      "description": "Organism entries for dynamic card generation.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type",
          "description",
          "habitat",
          "environment_role",
          "rarity"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "move_set": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": {
            "type": "string"
          },
          "habitat": {
            "type": "string"
          },
          "habitat_type": {
            "type": "string"
          },
          "environment_role": {
            "type": "string"
          },
          "physical_dimensions": {
            "type": "string"
          },
          "rarity": {
            "type": "string"
          },
          "related_forms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lifecycle_stage": {
            "type": "string"
          },
          "group": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "content_kind": {
            "enum": [
              "fictional",
              "unreviewed",
              "source_checked",
              "reviewed"
            ]
          },
          "scientific_name": {
            "type": "string"
          },
          "reviewed_by": {
            "type": "string"
          },
          "reviewed_on": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "title",
                "publisher",
                "url",
                "accessed_on",
                "supports",
                "license",
                "attribution"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "publisher": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "minLength": 1
                },
                "accessed_on": {
                  "type": "string",
                  "minLength": 1
                },
                "license": {
                  "type": "string",
                  "minLength": 1
                },
                "attribution": {
                  "type": "string",
                  "minLength": 1
                },
                "revision_url": {
                  "type": "string"
                },
                "supports": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "enum": [
                      "scientific_name",
                      "name",
                      "type",
                      "description",
                      "habitat",
                      "habitat_type",
                      "environment_role",
                      "physical_dimensions",
                      "related_forms",
                      "lifecycle_stage",
                      "group",
                      "notes"
                    ]
                  }
                },
                "evidence": {
                  "type": "object",
                  "required": [
                    "location",
                    "excerpt",
                    "sha256"
                  ],
                  "properties": {
                    "location": {
                      "type": "string",
                      "minLength": 1
                    },
                    "excerpt": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          "organism_id": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "content_kind"
              ],
              "properties": {
                "content_kind": {
                  "enum": [
                    "source_checked",
                    "reviewed"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "scientific_name",
                "reviewed_by",
                "reviewed_on",
                "sources"
              ],
              "properties": {
                "sources": {
                  "minItems": 1
                },
                "scientific_name": {
                  "minLength": 1
                },
                "reviewed_by": {
                  "minLength": 1
                },
                "reviewed_on": {
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    },
    "art_assets": {
      "type": "array",
      "description": "Art prompts and image references associated with organisms.",
      "items": {
        "type": "object",
        "required": [
          "organism_name",
          "prompt",
          "assets"
        ],
        "properties": {
          "organism_name": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "assets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
